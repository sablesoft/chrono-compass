{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "checkJs": false,
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": [
    "server/**/*.ts",
    "src/lib/api/**/*.ts",
    "scripts/moment-api-schema.ts",
    "scripts/moment-api-fixture.ts",
    "serverless/src/**/*.ts"
  ]
}
