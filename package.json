{
  "name": "chrono-compass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-help.mjs",
    "preview": "vite preview",
    "test:seo": "node scripts/test-seo.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json",
    "test:constellation:chart": "node scripts/validate-constellation-spherical.mjs --layer=chart",
    "test:constellation:spherical:chart-old": "node scripts/validate-constellation-spherical.mjs --layer=spherical --algo=chart-old",
    "test:constellation:spherical": "node scripts/validate-constellation-spherical.mjs",
    "test:calendar": "node --experimental-strip-types scripts/test-calendar.mjs",
    "test:calendar:events": "node scripts/test-calendar-events.mjs",
    "test:calendar:print": "node scripts/test-calendar-print.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:production": "npm run build && npm run build:api",
    "start": "node dist-ssr/index.js",
    "test:api": "node scripts/test-moment-api.mjs",
    "build:functions": "node scripts/build-functions.mjs",
    "test:functions": "node scripts/build-functions.mjs --check && node scripts/test-functions.mjs",
    "test:client": "node scripts/test-client-boundary.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/suncalc": "^1.9.2",
    "@typescript-eslint/types": "^8.54.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "ajv": "^8.20.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "astronomy-engine": "^2.1.19",
    "markdown-it": "^14.1.0",
    "svelte-portal": "^2.2.1"
  }
}
